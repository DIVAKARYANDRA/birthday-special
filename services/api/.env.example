# services/api — Environment variable template
# See docs/06-engineering-foundation.md, Section 3.
# Copy this file to .env.local (or the appropriate .env.<environment> file)
# and fill in real values there. NEVER commit a populated .env file.
#
# Field names below match app/core/config.py's Settings class exactly
# (case-insensitive) — see that file for the authoritative shape and
# defaults of every value the platform currently knows about.

# ---------- Application identity ----------
# One of: development | testing | production (docs/06-engineering-foundation.md, Section 2)
ENVIRONMENT=development
APP_NAME=The Journey To My Heart — API
LOG_LEVEL=INFO

# ---------- Database ----------
# Real connection string, consumed by app/db/session.py (Prompt 9). NEVER
# point this at a database containing real personal content in local
# development (docs/06-engineering-foundation.md, Section 2) — use a local,
# synthetic-data-only PostgreSQL instance instead.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/journey_to_my_heart

# Optional — only needed if a future test setup explicitly opts into a
# real (rather than the default in-memory) test database. See
# app/db/testing.py for the default strategy, which does not require this.
TEST_DATABASE_URL=

# Connection pool tuning — conservative defaults are already set in
# app/core/config.py; only override if a specific environment needs to.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
# Local-development debugging aid only — logs full SQL query text.
# NEVER enable in production (docs/06-engineering-foundation.md, Section 11).
DATABASE_ECHO=false

# ---------- Authentication ----------
# Generate a strong, unique value per environment. Never reuse a
# testing-environment key in production (docs/04-backend-architecture.md, Section 4).
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------- Cloudinary ----------
# Use a separate folder namespace/preset per environment
# (docs/06-engineering-foundation.md, Section 3) so local/testing uploads
# never mix with production media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- CORS ----------
# Locked to the two known frontend origins (docs/04-backend-architecture.md, Section 15).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- Site-wide visitor password ----------
# Hashed server-side; never stored or compared in plaintext.
SITE_PASSWORD_HASH=
