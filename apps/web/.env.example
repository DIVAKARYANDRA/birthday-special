# apps/web — Environment variable template
# See docs/06-engineering-foundation.md, Section 3.
# Copy this file to .env.local (or the appropriate .env.<environment> file)
# and fill in real values there. NEVER commit a populated .env file.

# Base URL of the backend API this environment targets.
VITE_API_BASE_URL=http://localhost:8000

# Cloudinary cloud name (public identifier only — never the API secret,
# which lives exclusively on the backend per docs/04-backend-architecture.md,
# Section 15).
VITE_CLOUDINARY_CLOUD_NAME=

# Site-wide visitor password gate is enforced server-side; the frontend
# holds no password-related secret values.
